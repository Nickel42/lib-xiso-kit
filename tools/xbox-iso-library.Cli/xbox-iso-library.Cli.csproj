<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>xboxiso</AssemblyName>
    <RootNamespace>XboxIsoLibrary.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installable with `dotnet tool install -g xbox-iso-library.Cli`; standalone binaries come from the release workflow. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>xbox-iso-library.Cli</PackageId>
    <ToolCommandName>xboxiso</ToolCommandName>
    <Description>xboxiso: command-line tool for original Xbox disc images, built on xbox-iso-library. Show info, analyze, shrink (rebuild or trim), convert between ISO, CCI and CSO, split, verify, pack and extract, hash against Redump DATs, and run a self-test.</Description>
    <PackageTags>xbox;original-xbox;xiso;iso;cci;cso;shrink;cli;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\xbox-iso-library\xbox-iso-library.csproj" />
  </ItemGroup>
</Project>
